# Application under test
BASE_URL=http://localhost:3000
# API base URL (leave empty to use BASE_URL)
API_BASE_URL=
# true  = start the bundled demo app automatically
# false = test your own application at BASE_URL / API_BASE_URL
USE_DEMO_APP=true

# Browser: chromium | firefox | webkit
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
DEFAULT_TIMEOUT=30000

# API performance threshold in ms
API_MAX_RESPONSE_MS=2000

# Test users (the standard user is also the "already registered" email)
EXISTING_USER_EMAIL=existing.user@example.com
STANDARD_USER_PASSWORD=Passw0rd!23
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
LOCKED_USER_EMAIL=locked.user@example.com
LOCKED_USER_PASSWORD=Passw0rd!23
